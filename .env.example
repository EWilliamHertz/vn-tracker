# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# For authentication redirect URLs
# When running locally: http://localhost:3000
# When running in Google Cloud Shell: https://[PORT]-[PROJECT-ID].cloudshell.dev
# Set this to your actual deployed/running URL for email magic links to work correctly
NEXT_PUBLIC_SITE_URL=http://localhost:3000
